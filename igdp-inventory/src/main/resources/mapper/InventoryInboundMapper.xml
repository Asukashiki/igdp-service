<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inspur.agriculture.inventory.mapper.InventoryInboundMapper">

    <resultMap id="InboundResultMap" type="com.inspur.agriculture.inventory.domain.InventoryInbound">
        <id property="id" column="id"/>
        <result property="inboundNo" column="inbound_no"/>
        <result property="warehouseCode" column="warehouse_code"/>
        <result property="warehouseName" column="warehouse_name"/>
        <result property="type" column="type"/>
        <result property="status" column="status"/>
        <result property="bizNo" column="biz_no"/>
        <result property="operator" column="operator"/>
        <result property="orderDate" column="order_date"/>
        <result property="auditBy" column="audit_by"/>
        <result property="auditTime" column="audit_time"/>
        <result property="auditComment" column="audit_comment"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <select id="selectInboundWithWarehouse" resultMap="InboundResultMap">
        SELECT 
            io.id,
            io.inbound_no,
            io.warehouse_code,
            w.warehouse_name,
            io.type,
            io.status,
            io.biz_no,
            io.operator,
            io.order_date,
            io.audit_by,
            io.audit_time,
            io.audit_comment,
            io.create_by,
            io.create_time,
            io.update_by,
            io.update_time,
            io.remark
        FROM inventory_inbound_order io
        LEFT JOIN inventory_warehouse w ON io.warehouse_code = w.warehouse_code
        WHERE io.id = #{id}
    </select>

    <select id="selectInboundListWithWarehouse" resultMap="InboundResultMap">
        SELECT 
            io.id,
            io.inbound_no,
            io.warehouse_code,
            w.warehouse_name,
            io.type,
            io.status,
            io.biz_no,
            io.operator,
            io.order_date,
            io.audit_by,
            io.audit_time,
            io.audit_comment,
            io.create_by,
            io.create_time,
            io.update_by,
            io.update_time,
            io.remark
        FROM inventory_inbound_order io
        LEFT JOIN inventory_warehouse w ON io.warehouse_code = w.warehouse_code
        <where>
            <if test="inboundNo != null and inboundNo != ''">
                AND io.inbound_no LIKE CONCAT('%', #{inboundNo}, '%')
            </if>
            <if test="type != null and type != ''">
                AND io.type = #{type}
            </if>
            <if test="status != null and status != ''">
                <choose>
                    <when test="status.indexOf(',') &gt; -1">
                        AND io.status IN
                        <foreach collection="status.split(',')" item="s" open="(" separator="," close=")">
                            #{s}
                        </foreach>
                    </when>
                    <otherwise>
                        AND io.status = #{status}
                    </otherwise>
                </choose>
            </if>
            <if test="warehouseCode != null and warehouseCode != ''">
                AND io.warehouse_code = #{warehouseCode}
            </if>
        </where>
        ORDER BY io.create_time DESC
    </select>

</mapper>
