<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inspur.agriculture.inventory.mapper.InventoryStockMapper">

    <resultMap type="com.inspur.agriculture.inventory.domain.InventoryStock" id="InventoryStockResult">
        <id property="id" column="id"/>
        <result property="productId" column="product_id"/>
        <result property="warehouseId" column="warehouse_id"/>
        <result property="availableQty" column="available_qty"/>
        <result property="lockedQty" column="locked_qty"/>
        <result property="qualityGrade" column="quality_grade"/>
        <result property="stockStatus" column="stock_status"/>
        <result property="version" column="version"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="productName" column="product_name"/>
        <result property="productCode" column="product_code"/>
        <result property="mainCategory" column="main_category"/>
        <result property="subCategory" column="sub_category"/>
        <result property="warehouseName" column="warehouse_name"/>
        <result property="unit" column="unit"/>
        <result property="batchId" column="batch_id"/>
        <result property="batchNo" column="batch_no"/>
    </resultMap>

    <sql id="selectInventoryStockVo">
        SELECT s.id, s.product_id, s.warehouse_id,
               s.available_qty, s.locked_qty, s.quality_grade, s.stock_status, s.version,
               s.create_by, s.create_time, s.update_by, s.update_time, s.remark,
               p.product_name, p.product_code, p.main_category, p.sub_category, w.warehouse_name,
               lb.batch_id AS batch_id, lb.batch_no AS batch_no, lb.unit AS unit
        FROM inventory_stock s
        LEFT JOIN inventory_product p ON s.product_id = p.id
        LEFT JOIN inventory_warehouse w ON s.warehouse_id = w.id
        LEFT JOIN (
            SELECT b.product_id AS product_id, b.warehouse_id AS warehouse_id,
                   b.id AS batch_id, b.batch_no AS batch_no,b.unit AS unit,
                   b.main_category AS main_category, b.sub_category AS sub_category
            FROM inventory_stock_batch b
            INNER JOIN (
                SELECT product_id, warehouse_id, MAX(id) AS max_id
                FROM inventory_stock_batch
                GROUP BY product_id, warehouse_id
            ) m ON b.id = m.max_id
        ) lb ON p.id = lb.product_id AND s.warehouse_id = lb.warehouse_id
    </sql>

    <select id="selectStockList" parameterType="com.inspur.agriculture.inventory.domain.InventoryStock" resultMap="InventoryStockResult">
        <include refid="selectInventoryStockVo"/>
        <where>
            <if test="productId != null"> AND s.product_id = #{productId} </if>
            <if test="warehouseId != null"> AND s.warehouse_id = #{warehouseId} </if>
            <if test="productName != null and productName != ''"> AND p.product_name LIKE concat('%', #{productName}, '%') </if>
            <if test="warehouseName != null and warehouseName != ''"> AND w.warehouse_name LIKE concat('%', #{warehouseName}, '%') </if>
        </where>
    </select>

    <select id="selectStockById" parameterType="java.lang.Long" resultMap="InventoryStockResult">
        <include refid="selectInventoryStockVo"/>
        WHERE s.id = #{id}
    </select>

    <update id="updateStockOptimistic">
        UPDATE inventory_stock
        SET available_qty = available_qty - #{qty},
            locked_qty = locked_qty + #{qty},
            version = version + 1,
            update_time = NOW()
        WHERE id = #{id} 
          AND version = #{version}
          AND available_qty >= #{qty}
    </update>

</mapper>
