<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inspur.agriculture.inventory.mapper.InventoryProductMapper">

    <resultMap id="InventoryProductResult" type="com.inspur.agriculture.inventory.domain.InventoryProduct">
        <id property="id" column="id"/>
        <result property="productCode" column="product_code"/>
        <result property="productName" column="product_name"/>
        <result property="categoryId" column="category_id"/>
        <result property="categoryName" column="category_name"/>
        <result property="mainCategory" column="main_category"/>
        <result property="subCategory" column="sub_category"/>
        <result property="brand" column="brand"/>
        <result property="model" column="model"/>
        <result property="unit" column="unit"/>
        <result property="price" column="price"/>
        <result property="licenseNo" column="license_no"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="parentId" column="parent_id"/>
    </resultMap>

    <sql id="selectInventoryProductVo">
        SELECT id,
               product_code,
               product_name,
               category_id,
               category_name,
               main_category,
               sub_category,
               brand,
               model,
               unit,
               price,
               license_no,
               status,
               create_by,
               create_time,
               update_by,
               update_time,
               remark,
               parent_id
        FROM inventory_product
    </sql>

    <select id="selectProductList" parameterType="com.inspur.agriculture.inventory.domain.InventoryProduct" resultMap="InventoryProductResult">
        <include refid="selectInventoryProductVo"/>
        <where>
            <if test="productCode != null and productCode != ''">
                AND product_code LIKE concat('%', #{productCode}, '%')
            </if>
            <if test="productName != null and productName != ''">
                AND product_name LIKE concat('%', #{productName}, '%')
            </if>
            <if test="categoryName != null and categoryName != ''">
                AND category_name LIKE concat('%', #{categoryName}, '%')
            </if>
            <if test="mainCategory != null and mainCategory != ''">
                AND main_category = #{mainCategory}
            </if>
            <if test="subCategory != null and subCategory != ''">
                AND sub_category LIKE concat('%', #{subCategory}, '%')
            </if>
            <if test="brand != null and brand != ''">
                AND brand LIKE concat('%', #{brand}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="parentId != null">
                <choose>
                    <when test="parentId == 0">
                        AND (parent_id = 0 OR parent_id IS NULL)
                    </when>
                    <otherwise>
                        AND parent_id = #{parentId}
                    </otherwise>
                </choose>
            </if>
            <if test="keyword != null and keyword != ''">
                AND (
                    product_code LIKE concat('%', #{keyword}, '%')
                    OR product_name LIKE concat('%', #{keyword}, '%')
                    OR category_name LIKE concat('%', #{keyword}, '%')
                    OR brand LIKE concat('%', #{keyword}, '%')
                )
            </if>
        </where>
        ORDER BY create_time DESC, id DESC
    </select>

    <select id="selectProductById" parameterType="java.lang.Long" resultMap="InventoryProductResult">
        <include refid="selectInventoryProductVo"/>
        WHERE id = #{id}
    </select>

</mapper>
