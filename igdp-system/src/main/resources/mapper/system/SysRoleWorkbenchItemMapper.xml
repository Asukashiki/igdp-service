<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inspur.system.mapper.SysRoleWorkbenchItemMapper">


    <select id="selectItemIdByUserId" resultType="java.lang.Long">
        select ri.item_id
        from sys_role_workbench_item ri
                 left join sys_user_role ur on ur.role_id = ri.role_id
        where ur.user_id = #{userId}
    </select>
</mapper>