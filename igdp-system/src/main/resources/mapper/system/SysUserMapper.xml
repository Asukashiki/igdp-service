    <select id="selectUserPageByParams" resultMap="SysUserResult">
        <include refid="selectUserVo"/>
        where u.del_flag = '0'
        <if test="queryParams.status != null and queryParams.status != ''">
            AND u.status = #{queryParams.status}
        </if>
        <if test="queryParams.allowedShow != null and queryParams.allowedShow != ''">
            AND u.allowed_show = #{queryParams.allowedShow}
        </if>
        <if test="queryParams.userId != null">
            AND u.user_id = #{queryParams.userId}
        </if>
        <if test="queryParams.userName != null and queryParams.userName != ''">
            AND u.user_name like concat('%', #{queryParams.userName}, '%')
        </if>
        <if test="queryParams.status != null and queryParams.status != ''">
            AND u.status = #{queryParams.status}
        </if>
        <if test="queryParams.phoneNumber != null and queryParams.phoneNumber != ''">
            AND u.phone_number like concat('%', #{queryParams.phoneNumber}, '%')
        </if>
        <if test="queryParams.deptId != null">
            AND (u.dept_id = #{queryParams.deptId} OR u.dept_id IN ( SELECT sd.DEPT_ID FROM sys_dept sd LEFT JOIN sys_dept sd2 ON sd.ancestors LIKE CONCAT(sd2.ANCESTORS, '%') WHERE sd2.DEPT_ID = #{deptId} ))
        </if>
        <if test="queryParams.params.keyword != null and queryParams.params.keyword != ''">
            and(
            u.user_id like concat('%',#{queryParams.params.keyword},'%') or u.nick_name like concat('%',#{queryParams.params.keyword},'%')
            or u.user_name like concat('%',#{queryParams.params.keyword},'%') or u.phone_number like
            concat('%',#{queryParams.params.keyword},'%')
            or u.email like concat('%',#{queryParams.params.keyword},'%')
            )
        </if>
        <if test="queryParams.roleId != null and queryParams.roleId != ''">
            and ur.role_id = #{queryParams.roleId}
        </if>
        <if test="queryParams.roleKey != null and queryParams.roleKey != ''">
            and r.role_key = #{queryParams.roleKey}
        </if>
    </select>

