<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inspur.agriculture.input.mapper.supplier.SupplierCertMapper">

    <resultMap type="com.inspur.agriculture.input.domain.supplier.SupplierCert" id="SupplierCertResult">
        <id     property="certId"           column="cert_id"           />
        <result property="userId"           column="user_id"           />
        <result property="orgName"          column="org_name"          />
        <result property="creditCode"       column="credit_code"       />
        <result property="legalPerson"      column="legal_person"      />
        <result property="legalId"          column="legal_id"          />
        <result property="adCode"           column="ad_code"           />
        <result property="businessScope"    column="business_scope"    />
        <result property="licensePath"      column="license_path"      />
        <result property="contactName"      column="contact_name"      />
        <result property="contactPhone"     column="contact_phone"     />
        <result property="applyTime"        column="apply_time"        />
        <result property="status"           column="status"            />
        <result property="approverId"       column="approver_id"       />
        <result property="approveTime"      column="approve_time"      />
        <result property="auditOpinion"     column="audit_opinion"     />
        <result property="rejectReason"     column="reject_reason"     />
        <result property="createPeople"     column="create_people"     />
        <result property="createTime"       column="create_time"       />
        <result property="updatePeople"     column="update_people"     />
        <result property="updateTime"       column="update_time"       />
        <result property="delFlag"          column="del_flag"          />
    </resultMap>

    <sql id="selectSupplierCertVo">
        select cert_id, user_id, org_name, credit_code, legal_person, legal_id,
               ad_code, business_scope, license_path, contact_name, contact_phone,
               apply_time, status, approver_id, approve_time, audit_opinion, reject_reason,
               create_people, create_time, update_people, update_time, del_flag
        from supplier_cert
    </sql>

    <select id="selectCertList" parameterType="com.inspur.agriculture.input.domain.supplier.SupplierCert" resultMap="SupplierCertResult">
        <include refid="selectSupplierCertVo"/>
        where del_flag = '0'
        <if test="userId != null">
            and user_id = #{userId}
        </if>
        <if test="orgName != null and orgName != ''">
            and org_name like concat('%', #{orgName}, '%')
        </if>
        <if test="creditCode != null and creditCode != ''">
            and credit_code = #{creditCode}
        </if>
        <if test="status != null">
            and status = #{status}
        </if>
        order by create_time desc
    </select>

    <select id="selectCertByUserId" parameterType="Long" resultMap="SupplierCertResult">
        <include refid="selectSupplierCertVo"/>
        where user_id = #{userId} and del_flag = '0'
        order by create_time desc
        limit 1
    </select>

    <select id="selectCertById" parameterType="Long" resultMap="SupplierCertResult">
        <include refid="selectSupplierCertVo"/>
        where cert_id = #{certId} and del_flag = '0'
    </select>

    <select id="selectAuditList" parameterType="Integer" resultMap="SupplierCertResult">
        <include refid="selectSupplierCertVo"/>
        where status = #{status} and del_flag = '0'
        order by apply_time asc
    </select>

    <select id="selectAuditListWithConditions" resultMap="SupplierCertResult">
        <include refid="selectSupplierCertVo"/>
        where status = 1 and del_flag = '0'
        <if test="query.orgName != null and query.orgName != ''">
            and org_name like concat('%', #{query.orgName}, '%')
        </if>
        <if test="query.creditCode != null and query.creditCode != ''">
            and credit_code like concat('%', #{query.creditCode}, '%')
        </if>
        <if test="query.contactName != null and query.contactName != ''">
            and contact_name like concat('%', #{query.contactName}, '%')
        </if>
        <if test="query.contactPhone != null and query.contactPhone != ''">
            and contact_phone like concat('%', #{query.contactPhone}, '%')
        </if>
        <if test="query.adCode != null and query.adCode != ''">
            and ad_code = #{query.adCode}
        </if>
        <if test="query.applyTimeStart != null">
            and apply_time &gt;= #{query.applyTimeStart}
        </if>
        <if test="query.applyTimeEnd != null">
            and apply_time &lt;= #{query.applyTimeEnd}
        </if>
        <if test="query.keyword != null and query.keyword != ''">
            and (
                org_name like concat('%', #{query.keyword}, '%')
                or credit_code like concat('%', #{query.keyword}, '%')
                or contact_name like concat('%', #{query.keyword}, '%')
            )
        </if>
        order by apply_time asc
    </select>

    <select id="selectCertListWithConditions" resultMap="SupplierCertResult">
        <include refid="selectSupplierCertVo"/>
        where del_flag = '0'
        <if test="query.orgName != null and query.orgName != ''">
            and org_name like concat('%', #{query.orgName}, '%')
        </if>
        <if test="query.creditCode != null and query.creditCode != ''">
            and credit_code like concat('%', #{query.creditCode}, '%')
        </if>
        <if test="query.contactName != null and query.contactName != ''">
            and contact_name like concat('%', #{query.contactName}, '%')
        </if>
        <if test="query.contactPhone != null and query.contactPhone != ''">
            and contact_phone like concat('%', #{query.contactPhone}, '%')
        </if>
        <if test="query.status != null">
            and status = #{query.status}
        </if>
        <if test="query.adCode != null and query.adCode != ''">
            and ad_code = #{query.adCode}
        </if>
        <if test="query.applyTimeStart != null">
            and apply_time &gt;= #{query.applyTimeStart}
        </if>
        <if test="query.applyTimeEnd != null">
            and apply_time &lt;= #{query.applyTimeEnd}
        </if>
        <if test="query.approveTimeStart != null">
            and approve_time &gt;= #{query.approveTimeStart}
        </if>
        <if test="query.approveTimeEnd != null">
            and approve_time &lt;= #{query.approveTimeEnd}
        </if>
        <if test="query.keyword != null and query.keyword != ''">
            and (
                org_name like concat('%', #{query.keyword}, '%')
                or credit_code like concat('%', #{query.keyword}, '%')
                or contact_name like concat('%', #{query.keyword}, '%')
            )
        </if>
        order by create_time desc
    </select>

</mapper>
