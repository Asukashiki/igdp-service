<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inspur.agriculture.input.mapper.allocate.StateAnnualQuotaMapper">

    <!-- Result Map -->
    <resultMap id="StateAnnualQuotaVOMap" type="com.inspur.agriculture.input.domain.allocate.vo.StateAnnualQuotaVO">
        <id column="quota_id" property="quotaId"/>
        <result column="quota_name" property="quotaName"/>
        <result column="year" property="year"/>
        <result column="category_id" property="categoryId"/>
        <result column="category_name" property="categoryName"/>
        <result column="total_quota" property="totalQuota"/>
        <result column="operator_id" property="operatorId"/>
        <result column="operator_name" property="operatorName"/>
        <result column="operator_division_id" property="operatorDivisionId"/>
        <result column="operator_division_name" property="operatorDivisionName"/>
        <result column="modifier_id" property="modifierId"/>
        <result column="modifier_name" property="modifierName"/>
        <result column="modifier_division_name" property="modifierDivisionName"/>
        <result column="operate_time" property="operateTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- Page query with detail -->
    <select id="selectPageWithDetail" resultMap="StateAnnualQuotaVOMap">
        SELECT
            saq.quota_id,
            saq.quota_name,
            saq.year,
            saq.category_id,
            '' AS category_name,
            saq.total_quota,
            saq.operator_id,
            '' AS operator_name,
            saq.operator_division_id,
            '' AS operator_division_name,
            saq.modifier_id,
            '' AS modifier_name,
            '' AS modifier_division_name,
            saq.operate_time,
            saq.create_time,
            saq.update_time
        FROM
            t_state_annual_quota saq
        <where>
            <if test="year != null">
                AND saq.year = #{year}
            </if>
            <if test="categoryId != null and categoryId != ''">
                AND saq.category_id = #{categoryId}
            </if>
            <if test="operatorDivisionId != null and operatorDivisionId != ''">
                AND saq.operator_division_id = #{operatorDivisionId}
            </if>
        </where>
        ORDER BY saq.operate_time DESC
    </select>

    <!-- Get detail by ID -->
    <select id="selectDetailById" resultMap="StateAnnualQuotaVOMap">
        SELECT
            saq.quota_id,
            saq.quota_name,
            saq.year,
            saq.category_id,
            '' AS category_name,
            saq.total_quota,
            saq.operator_id,
            '' AS operator_name,
            saq.operator_division_id,
            '' AS operator_division_name,
            saq.modifier_id,
            '' AS modifier_name,
            '' AS modifier_division_name,
            saq.operate_time,
            saq.create_time,
            saq.update_time
        FROM
            t_state_annual_quota saq
        WHERE
            saq.quota_id = #{quotaId}
            <if test="operatorDivisionId != null and operatorDivisionId != ''">
                AND saq.operator_division_id = #{operatorDivisionId}
            </if>
    </select>

</mapper>
