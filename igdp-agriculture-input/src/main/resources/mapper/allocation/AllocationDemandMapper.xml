<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inspur.agriculture.input.mapper.allocation.AllocationDemandMapper">

    <!-- Result map for ZoneAllocationDemand -->
    <resultMap id="ZoneAllocationDemandResultMap" type="com.inspur.agriculture.input.domain.allocation.entity.AllocationDemand">
        <id column="id" property="id"/>
        <result column="allocation_id" property="allocationId"/>
        <result column="input_type" property="inputType"/>
        <result column="input_category" property="inputCategory"/>
        <result column="total_quantity" property="totalQuantity"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- Get demand list by allocation ID -->
    <select id="selectByAllocationId" resultMap="ZoneAllocationDemandResultMap">
        SELECT
            id,
            allocation_id,
            input_type,
            input_category,
            total_quantity,
            create_time,
            update_time
        FROM t_zone_allocation_demand
        WHERE allocation_id = #{allocationId}
        ORDER BY create_time ASC
    </select>

    <!-- Delete demand items by allocation ID -->
    <delete id="deleteByAllocationId">
        DELETE FROM t_zone_allocation_demand
        WHERE allocation_id = #{allocationId}
    </delete>
</mapper>
