<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inspur.seed.breeding.agronomicTrait.mapper.AgronomicTraitRecordMapper">

    <!-- 结果集映射（含明细列表） -->
    <resultMap id="RecordWithDetailsResult" type="com.inspur.seed.breeding.agronomicTrait.domain.entity.AgronomicTraitRecord">
        <id property="recordId" column="record_id"/>
        <result property="plotId" column="plot_id"/>
        <result property="trialId" column="trial_id"/>
        <result property="batchId" column="batch_id"/>
        <result property="observationDate" column="observation_date"/>
        <result property="growthStage" column="growth_stage"/>
        <result property="observerId" column="observer_id"/>
        <result property="photoUrl" column="photo_url"/>
        <result property="remarks" column="remarks"/>
        <result property="status" column="status"/>
        <result property="workflowStatus" column="workflow_status"/>
        <result property="auditBy" column="audit_by"/>
        <result property="auditTime" column="audit_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="isDeleted" column="is_deleted"/>
        <!-- 级联查询明细列表 -->
        <collection property="detailList" ofType="com.inspur.seed.breeding.agronomicTrait.domain.entity.AgronomicTraitDetail"
                    select="com.inspur.seed.breeding.agronomicTrait.mapper.AgronomicTraitDetailMapper.selectDetailsByRecordId"
                    column="record_id"/>
    </resultMap>

    <!-- 查询主记录列表（含性状数量统计） -->
    <select id="selectRecordList" parameterType="com.inspur.seed.breeding.agronomicTrait.domain.entity.AgronomicTraitRecord"
            resultType="com.inspur.seed.breeding.agronomicTrait.domain.entity.AgronomicTraitRecord">
        SELECT
            r.record_id,
            r.plot_id,
            r.trial_id,
            r.batch_id,
            r.observation_date,
            r.growth_stage,
            r.observer_id,
            r.photo_url,
            r.remarks,
            r.status,
            r.workflow_status,
            r.audit_by,
            r.audit_time,
            r.create_by,
            r.create_time,
            r.update_by,
            r.update_time,
            COUNT(d.detail_id) AS trait_count
        FROM agronomic_trait_record r
        LEFT JOIN agronomic_trait_detail d ON r.record_id = d.record_id AND d.is_deleted = 0
        WHERE r.is_deleted = 0
        <if test="recordId != null and recordId != ''">
            AND r.record_id LIKE CONCAT('%', #{recordId}, '%')
        </if>
        <if test="plotId != null and plotId != ''">
            AND r.plot_id = #{plotId}
        </if>
        <if test="trialId != null and trialId != ''">
            AND r.trial_id = #{trialId}
        </if>
        <if test="batchId != null and batchId != ''">
            AND r.batch_id = #{batchId}
        </if>
        <if test="growthStage != null and growthStage != ''">
            AND r.growth_stage = #{growthStage}
        </if>
        <if test="observerId != null and observerId != ''">
            AND r.observer_id = #{observerId}
        </if>
        <if test="status != null and status != ''">
            AND r.status = #{status}
        </if>
        <if test="workflowStatus != null and workflowStatus != ''">
            AND r.workflow_status = #{workflowStatus}
        </if>
        <if test="observationDateBegin != null">
            AND r.observation_date &gt;= #{observationDateBegin}
        </if>
        <if test="observationDateEnd != null">
            AND r.observation_date &lt;= #{observationDateEnd}
        </if>
        <if test="createBy != null and createBy != ''">
            AND r.create_by = #{createBy}
        </if>
        <if test="createTimeBegin != null">
            AND r.create_time &gt;= #{createTimeBegin}
        </if>
        <if test="createTimeEnd != null">
            AND r.create_time &lt;= #{createTimeEnd}
        </if>
        <if test="updateBy != null and updateBy != ''">
            AND r.update_by = #{updateBy}
        </if>
        <if test="updateTimeBegin != null">
            AND r.update_time &gt;= #{updateTimeBegin}
        </if>
        <if test="updateTimeEnd != null">
            AND r.update_time &lt;= #{updateTimeEnd}
        </if>
        <if test="auditBy != null and auditBy != ''">
            AND r.audit_by = #{auditBy}
        </if>
        <if test="auditTimeBegin != null">
            AND r.audit_time &gt;= #{auditTimeBegin}
        </if>
        <if test="auditTimeEnd != null">
            AND r.audit_time &lt;= #{auditTimeEnd}
        </if>
        GROUP BY r.record_id
        ORDER BY r.create_time DESC
    </select>

    <!-- 根据ID查询主记录详情（级联查询明细） -->
    <select id="selectRecordByIdWithDetails" resultMap="RecordWithDetailsResult">
        SELECT * FROM agronomic_trait_record
        WHERE record_id = #{recordId} AND is_deleted = 0
    </select>

    <!-- 生成新的记录序号 -->
    <select id="generateRecordSequence" resultType="java.lang.Integer">
        SELECT IFNULL(MAX(CAST(SUBSTRING_INDEX(record_id, '-TR', -1) AS UNSIGNED)), 0) + 1
        FROM agronomic_trait_record
        WHERE plot_id = #{plotId}
    </select>

</mapper>
