<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inspur.seed.mapper.PlotInfoMapper">

    <resultMap type="com.inspur.seed.domain.PlotInfo" id="PlotInfoResult">
        <id property="plotId" column="plot_id"/>
        <result property="trialId" column="trial_id"/>
        <result property="batchId" column="batch_id"/>
        <result property="replicationNo" column="replication_no"/>
        <result property="rowNo" column="row_no"/>
        <result property="columnNo" column="column_no"/>
        <result property="varietyCode" column="variety_code"/>
        <result property="sowingDate" column="sowing_date"/>
        <result property="seedQuantity" column="seed_quantity"/>
        <result property="sowingMethod" column="sowing_method"/>
        <result property="sowingTime" column="sowing_time"/>
        <result property="region" column="region"/>
        <result property="zone" column="zone"/>
        <result property="woreda" column="woreda"/>
        <result property="kebele" column="kebele"/>
        <result property="plotAreaM2" column="plot_area_m2"/>
        <result property="gpsLat" column="gps_lat"/>
        <result property="gpsLong" column="gps_long"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="varietyName" column="variety_name"/>
    </resultMap>

    <sql id="selectPlotInfoVo">
        select p.plot_id, p.trial_id, p.batch_id, p.replication_no, p.row_no, p.column_no,
               p.variety_code, p.sowing_date, p.seed_quantity, p.sowing_method, p.sowing_time,
               p.region, p.zone, p.woreda, p.kebele,
               p.plot_area_m2, p.gps_lat, p.gps_long,
               p.create_time, p.update_time, p.create_by, p.update_by, p.is_deleted
        from plot_info p

    </sql>

    <select id="selectPlotInfoList" parameterType="com.inspur.seed.domain.PlotInfo" resultMap="PlotInfoResult">
        <include refid="selectPlotInfoVo"/>
        <where>
            p.is_deleted = 0
            <if test="batchId != null and batchId != ''">
                AND p.batch_id = #{batchId}
            </if>
            <if test="trialId != null and trialId != ''">
                AND p.trial_id = #{trialId}
            </if>
            <if test="varietyCode != null and varietyCode != ''">
                AND p.variety_code = #{varietyCode}
            </if>
        </where>
        order by p.create_time desc
    </select>

    <select id="selectPlotInfoById" parameterType="String" resultMap="PlotInfoResult">
        <include refid="selectPlotInfoVo"/>
        where p.plot_id = #{plotId} and p.is_deleted = 0
    </select>

    <select id="selectPlotsByTrialId" parameterType="String" resultMap="PlotInfoResult">
        <include refid="selectPlotInfoVo"/>
        where p.trial_id = #{trialId} and p.is_deleted = 0
        order by p.replication_no, p.row_no, p.column_no
    </select>

    <select id="selectPlotsByBatchId" parameterType="String" resultMap="PlotInfoResult">
        <include refid="selectPlotInfoVo"/>
        where p.batch_id = #{batchId} and p.is_deleted = 0
        order by p.create_time desc
    </select>

    <select id="selectPlotOptions" resultMap="PlotInfoResult">
        <include refid="selectPlotInfoVo"/>
        <where>
            p.is_deleted = 0
            <if test="batchId != null and batchId != ''">
                AND p.batch_id = #{batchId}
            </if>
            <if test="trialId != null and trialId != ''">
                AND p.trial_id = #{trialId}
            </if>
        </where>
        order by p.create_time desc
    </select>

</mapper>
