<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inspur.seed.mapper.EnvironmentDataMapper">

    <resultMap type="com.inspur.seed.domain.EnvironmentData" id="EnvironmentDataResult">
        <id property="envId" column="env_id"/>
        <result property="batchId" column="batch_id"/>
        <result property="trialId" column="trial_id"/>
        <result property="groundId" column="ground_id"/>
        <result property="dataType" column="data_type"/>
        <result property="collectTime" column="collect_time"/>
        <result property="soilPh" column="soil_ph"/>
        <result property="soilTemperature" column="soil_temperature"/>
        <result property="soilMoisture" column="soil_moisture"/>
        <result property="airTemperature" column="air_temperature"/>
        <result property="airHumidity" column="air_humidity"/>
        <result property="rainfall" column="rainfall"/>
        <result property="waterPh" column="water_ph"/>
        <result property="dataSource" column="data_source"/>
        <result property="remark" column="remarks"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="isDeleted" column="is_deleted"/>
    </resultMap>

    <sql id="selectEnvironmentDataVo">
        select env_id, batch_id, trial_id, ground_id, data_type, collect_time,
               soil_ph, soil_temperature, soil_moisture, air_temperature,
               air_humidity, rainfall, water_ph, data_source, remarks,
               create_time, update_time, create_by, update_by, is_deleted
        from environment_data
    </sql>

    <select id="selectEnvironmentDataList" parameterType="com.inspur.seed.domain.EnvironmentData" resultMap="EnvironmentDataResult">
        <include refid="selectEnvironmentDataVo"/>
        <where>
            is_deleted = 0
            <if test="batchId != null and batchId != ''">
                AND batch_id = #{batchId}
            </if>
            <if test="trialId != null and trialId != ''">
                AND trial_id = #{trialId}
            </if>
            <if test="groundId != null and groundId != ''">
                AND ground_id = #{groundId}
            </if>
            <if test="dataType != null and dataType != ''">
                AND data_type = #{dataType}
            </if>
            <if test="startTime != null and startTime != ''">
                AND collect_time &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND collect_time &lt;= #{endTime}
            </if>
        </where>
        order by collect_time desc, create_time desc
    </select>

    <select id="selectEnvironmentDataById" parameterType="String" resultMap="EnvironmentDataResult">
        <include refid="selectEnvironmentDataVo"/>
        where env_id = #{envId} and is_deleted = 0
    </select>

</mapper>
