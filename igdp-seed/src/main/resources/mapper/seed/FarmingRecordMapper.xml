<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inspur.seed.mapper.FarmingRecordMapper">

    <resultMap type="com.inspur.seed.domain.FarmingRecord" id="FarmingRecordResult">
        <id property="farmingId" column="farming_id"/>
        <result property="farmingRecordId" column="farming_record_id"/>
        <result property="plotId" column="plot_id"/>
        <result property="trialId" column="trial_id"/>
        <result property="batchId" column="batch_id"/>
        <result property="activityDate" column="activity_date"/>
        <result property="activityType" column="activity_type"/>
        <result property="inputName" column="input_name"/>
        <result property="quantity" column="quantity"/>
        <result property="unit" column="unit"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operationDesc" column="operation_desc"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="auditBy" column="audit_by"/>
        <result property="auditRemark" column="audit_remark"/>
        <result property="auditTime" column="audit_time"/>
        <result property="workflowStatus" column="workflow_status"/>
    </resultMap>

    <sql id="selectFarmingRecordVo">
        select f.farming_id, f.farming_record_id, f.plot_id, f.trial_id, f.batch_id,
               f.activity_date, f.activity_type, f.input_name, f.quantity, f.unit,
               f.operator_id, f.operation_desc,
               f.create_time, f.update_time, f.create_by, f.update_by, f.is_deleted,
               f.audit_by, f.audit_remark, f.audit_time, f.workflow_status
        from farming_record f
    </sql>

    <select id="selectFarmingRecordList" parameterType="com.inspur.seed.domain.FarmingRecord" resultMap="FarmingRecordResult">
        <include refid="selectFarmingRecordVo"/>
        <where>
            f.is_deleted = 0
            <!-- 新增：trialId 筛选条件 -->
            <if test="trialId != null and trialId != ''">
                AND f.trial_id = #{trialId}
            </if>
            <if test="plotId != null and plotId != ''">
                AND f.plot_id = #{plotId}
            </if>
            <if test="activityType != null and activityType != ''">
                AND f.activity_type = #{activityType}
            </if>
            <if test="activityDate != null and activityDate != ''">
                AND DATE(f.activity_date) = #{activityDate}
            </if>
            <!-- 可选：补充 batchId 筛选（如果前端需要传批次ID） -->
            <if test="batchId != null and batchId != ''">
                AND f.batch_id = #{batchId}
            </if>
        </where>
        order by f.activity_date desc, f.create_time desc
    </select>
    <select id="selectFarmingRecordById" parameterType="String" resultMap="FarmingRecordResult">
        <include refid="selectFarmingRecordVo"/>
        where f.farming_id = #{farmingId} and f.is_deleted = 0
    </select>

    <select id="getMaxRecordNoByPlotId" parameterType="String" resultType="int">
        select COALESCE(MAX(
            CAST(SUBSTRING(farming_record_id, LOCATE('-F', farming_record_id) + 2) AS UNSIGNED)
        ), 0) as max_record_no
        from farming_record
        where plot_id = #{plotId}
        and is_deleted = 0
        and farming_record_id like CONCAT(#{plotId}, '-F%')
    </select>

    <select id="getIrrigationCountByPlot" resultType="map">
        SELECT 
            plot_id as plotId,
            COUNT(*) as count
        FROM farming_record
        WHERE activity_type = 'irrigation'
          AND is_deleted = 0
        GROUP BY plot_id
    </select>

</mapper>
